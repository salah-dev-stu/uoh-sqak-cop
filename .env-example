# CipherChase secrets template (NFR-12 / R12).
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values,
# credentials.json, or token.json. The game + all tests run with NONE of
# these set (template LLM provider = 0 tokens, Gmail + MCP mocked).

# --- Gmail OAuth (real report send only; scope gmail.send) ---
# Path to the OAuth token produced by scripts/gmail_oauth_setup.py.
CIPHERCHASE_GMAIL_TOKEN=/absolute/path/to/token.json

# --- LLM providers (all OPTIONAL; default provider=template needs none) ---
# Claude CLI binary (subscription path, API key intentionally stripped).
CIPHERCHASE_CLAUDE_BIN=claude
# Ollama endpoint for a local small model.
CIPHERCHASE_OLLAMA_URL=http://localhost:11434
# Anthropic API key — ONLY if provider=claude_api. Leave unset otherwise.
ANTHROPIC_API_KEY=
